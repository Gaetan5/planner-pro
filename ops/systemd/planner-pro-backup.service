[Unit]
Description=Create and verify an encrypted Planner Pro MySQL backup
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/opt/planner-pro
Environment=PROJECT_DIR=/opt/planner-pro
Environment=BACKUP_DIR=/var/backups/planner-pro
Environment=PASSPHRASE_FILE=/etc/planner-pro/backup-passphrase
Environment=RETENTION_DAYS=30
ExecStart=/opt/planner-pro/scripts/backup-production.sh
UMask=0077
NoNewPrivileges=true
ProtectHome=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/backups/planner-pro /run/docker.sock
