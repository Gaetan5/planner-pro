# Use credentials and a dedicated, empty production volume. Never reuse a
# preproduction or unrelated application's volume for this new deployment.
MYSQL_ROOT_PASSWORD=replace_with_a_new_random_root_password
MYSQL_DATABASE=planner_pro
MYSQL_USER=planner_pro_app
MYSQL_PASSWORD=replace_with_a_new_random_application_password
MYSQL_VOLUME_NAME=planner_pro_production_mysql_data
FRONTEND_HOST_PORT=8080
BACKEND_HOST_PORT=3003

# Required application secrets. Generate fresh values for each environment.
JWT_SECRET=replace_with_a_unique_random_secret
ENCRYPTION_KEY=replace_with_a_32_character_base64_key
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Keep the service-account private key secret; use literal \n for line breaks.
FIREBASE_PRIVATE_KEY=
# Shadow mirror is opt-in; MySQL remains authoritative during this rollout.
FIRESTORE_SYNC_ENABLED=false
GITHUB_CLIENT_ID=replace_with_github_oauth_client_id
GITHUB_CLIENT_SECRET=replace_with_github_oauth_client_secret
GITHUB_WEBHOOK_SECRET=

# Public HTTPS origins. Add A records for both hostnames to the Oracle VM.
FRONTEND_URL=https://planner-pro.boukarou-os.com
CORS_ORIGINS=https://planner-pro.boukarou-os.com
VITE_API_URL=https://api.planner-pro.boukarou-os.com
# Obsolète depuis S9 : le frontend ne lit plus cette variable (l'URL d'autorisation, le state et la portée
# viennent du serveur via GITHUB_CLIENT_ID). Peut être retirée.
VITE_GITHUB_CLIENT_ID=replace_with_github_oauth_client_id
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Optional integrations
GEMINI_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@planner.pro
SMTP_SECURE=false

# --- Interrupteurs des fonctionnalités entreprise (audit P3) ---
# Désactivées par défaut : seule la valeur exacte "true" les active.
# Ne pas activer avant la fin de la Phase 2 du plan de sécurité (S10/S11).
FEATURE_SSO_ENABLED=false
FEATURE_SCIM_ENABLED=false
# Impersonation depuis la console admin (audit S18, étape 0) : désactivée tant que S18 n'est pas livré.
FEATURE_IMPERSONATION_ENABLED=false

# --- Connexion base de données (audit S4) ---
# TLS MySQL OBLIGATOIRE en production : le backend refuse de démarrer sans DATABASE_SSL=true.
# docker-compose.prod.yml fixe déjà DATABASE_SSL=true et DATABASE_SSL_CA=/run/secrets/mysql-ca.pem ;
# les certificats sont générés par ops/mysql-tls/generate-certs.sh dans secrets/mysql/
# (voir docs/deployment-production.md). Ces variables ne servent qu'à un déploiement hors compose.
DATABASE_SSL=true
# DATABASE_SSL_CA=/run/secrets/mysql-ca.pem
# DATABASE_RSA_PUBLIC_KEY n'est pas autorisée en production (développement et staging seulement).
