# Match these values to the existing MySQL server and Docker volume.
MYSQL_ROOT_PASSWORD=replace_with_existing_root_password
MYSQL_DATABASE=planner_pro
MYSQL_USER=planner_user
MYSQL_PASSWORD=replace_with_existing_application_password
MYSQL_VOLUME_NAME=replace_with_existing_volume_name
FRONTEND_HOST_PORT=8080
BACKEND_HOST_PORT=3003

# Required application secrets. Generate fresh values for each environment.
JWT_SECRET=replace_with_a_unique_random_secret
ENCRYPTION_KEY=replace_with_a_32_character_base64_key
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Keep the service-account private key secret; use literal \n for line breaks.
FIREBASE_PRIVATE_KEY=
GITHUB_CLIENT_ID=replace_with_github_oauth_client_id
GITHUB_CLIENT_SECRET=replace_with_github_oauth_client_secret
GITHUB_WEBHOOK_SECRET=

# Public HTTPS origins. Configure DNS and a TLS reverse proxy on the VPS.
FRONTEND_URL=https://app.example.com
CORS_ORIGINS=https://app.example.com
VITE_API_URL=https://api.example.com
VITE_GITHUB_CLIENT_ID=replace_with_github_oauth_client_id
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Optional integrations
GEMINI_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@planner.pro
SMTP_SECURE=false
