# Use credentials and a dedicated, empty production volume. Never reuse a
# preproduction or unrelated application's volume for this new deployment.
MYSQL_ROOT_PASSWORD=replace_with_a_new_random_root_password
MYSQL_DATABASE=planner_pro
MYSQL_USER=planner_pro_app
MYSQL_PASSWORD=replace_with_a_new_random_application_password
MYSQL_VOLUME_NAME=planner_pro_production_mysql_data
FRONTEND_HOST_PORT=8080
BACKEND_HOST_PORT=3003

# Required application secrets. Generate fresh values for each environment.
JWT_SECRET=replace_with_a_unique_random_secret
ENCRYPTION_KEY=replace_with_a_32_character_base64_key
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Keep the service-account private key secret; use literal \n for line breaks.
FIREBASE_PRIVATE_KEY=
# Shadow mirror is opt-in; MySQL remains authoritative during this rollout.
FIRESTORE_SYNC_ENABLED=false
GITHUB_CLIENT_ID=replace_with_github_oauth_client_id
GITHUB_CLIENT_SECRET=replace_with_github_oauth_client_secret
GITHUB_WEBHOOK_SECRET=

# Public HTTPS origins. Add A records for both hostnames to the Oracle VM.
FRONTEND_URL=https://planner-pro.boukarou-os.com
CORS_ORIGINS=https://planner-pro.boukarou-os.com
VITE_API_URL=https://api.planner-pro.boukarou-os.com
VITE_GITHUB_CLIENT_ID=replace_with_github_oauth_client_id
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Optional integrations
GEMINI_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@planner.pro
SMTP_SECURE=false
