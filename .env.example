# Configuration OAuth GitHub
# Use the same GitHub OAuth app in the backend and frontend.
GITHUB_CLIENT_ID=replace_with_github_oauth_client_id
GITHUB_CLIENT_SECRET=replace_with_github_oauth_client_secret
GITHUB_WEBHOOK_SECRET=

# Configuration JWT
# Generate a unique secret for each environment (e.g. openssl rand -hex 32).
JWT_SECRET=

# Generate 24 random bytes and encode as base64 (32 ASCII characters).
# Example: openssl rand -base64 24
ENCRYPTION_KEY=

# Firebase Auth (backend Admin SDK service account)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Store the private key with literal \n between lines; never commit the real key.
FIREBASE_PRIVATE_KEY=
# Optional shadow mirror; keep disabled until explicitly tested.
FIRESTORE_SYNC_ENABLED=false

# Configuration Base de données
DATABASE_URL=mysql://root:root_password@db:3306/planner_pro

# Configuration Redis
REDIS_HOST=cache
REDIS_PORT=6379

# Sécurité & CORS
CORS_ORIGINS=http://localhost:3004,http://localhost:3000

# Variables d'environnement Frontend (à définir dans frontend/.env)
VITE_API_URL=http://localhost:3003
VITE_GITHUB_CLIENT_ID=replace_with_github_oauth_client_id
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Configuration des services réels (Optionnel pour le développement local)
# Si définis, l'application bascule sur les API réelles.
# GEMINI_API_KEY=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=

# --- Interrupteurs des fonctionnalités entreprise (audit P3) ---
# Désactivées par défaut : seule la valeur exacte "true" les active.
# Ne pas activer avant la fin de la Phase 2 du plan de sécurité (S10/S11).
FEATURE_SSO_ENABLED=false
FEATURE_SCIM_ENABLED=false
# Impersonation depuis la console admin (audit S18, étape 0) : désactivée tant que S18 n'est pas livré.
FEATURE_IMPERSONATION_ENABLED=false

# --- Connexion base de données (audit S4) ---
# NODE_ENV doit valoir development ou test pour autoriser le DSN local par défaut
# et la récupération de la clé publique MySQL (allowPublicKeyRetrieval).
NODE_ENV=development
# TLS vers la base : true pour activer (certificat vérifié). DATABASE_SSL_CA : chemin d'un fichier PEM.
DATABASE_SSL=false
# DATABASE_SSL_CA=/run/secrets/mysql-ca.pem
# Alternative sans TLS (développement et staging uniquement, refusée en production) :
# chemin de la clé publique RSA du serveur MySQL (épinglée, jamais récupérée).
# DATABASE_RSA_PUBLIC_KEY=/run/secrets/mysql-public-key.pem
