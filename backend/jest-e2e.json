{
  "moduleFileExtensions": ["ts", "js", "json"],
  "rootDir": ".",
  "testTimeout": 30000,
  "roots": ["<rootDir>/tests/e2e"],
  "setupFiles": ["<rootDir>/tests/support/jest-env.ts"],
  "testRegex": ".*\\.e2e-spec\\.ts$",
  "transform": {
    "^.+\\.(t|j)s$": [
      "ts-jest",
      {
        "tsconfig": "<rootDir>/tsconfig.test.json"
      }
    ]
  },
  "testEnvironment": "node"
}
