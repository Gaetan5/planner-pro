model Workspace {
  id          String       @id @default(uuid())
  name        String
  ownerId     String
  owner       User         @relation("WorkspaceOwner", fields: [ownerId], references: [id])
  memberships Membership[]
  projects    Project[]
  teams       Team[]
  resourceProfiles ResourceProfile[]
  invitations   Invitation[]
  integrations  Integration[]
  sprints       Sprint[]
  ssoConfiguration SSOConfiguration?
  scimApiKeys   SCIMApiKey[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  deletedAt   DateTime?

  @@index([ownerId])
}

model Membership {
  id          String          @id @default(uuid())
  workspaceId String
  workspace   Workspace       @relation(fields: [workspaceId], references: [id])
  userId      String
  user        User            @relation(fields: [userId], references: [id])
  role        WorkspaceRole   @default(MEMBER)
  createdAt   DateTime        @default(now())

  @@unique([workspaceId, userId])
  @@index([userId])
}

model Team {
  id          String      @id @default(uuid())
  name        String
  workspaceId String
  workspace   Workspace   @relation(fields: [workspaceId], references: [id])
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  deletedAt   DateTime?

  @@index([workspaceId])
}

model Invitation {
  id          String           @id @default(uuid())
  email       String?          // Facultatif pour les liens de partage
  tokenHash   String           @unique
  role        WorkspaceRole    @default(MEMBER)
  status      InvitationStatus @default(PENDING)
  workspaceId String
  workspace   Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  projectId   String?
  project     Project?         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  invitedById String
  invitedBy   User             @relation("SentInvitations", fields: [invitedById], references: [id])
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([workspaceId])
  @@index([invitedById])
  @@index([projectId])
}

enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

enum SSOProvider {
  SAML2
  OIDC_AZURE_AD
  OIDC_GOOGLE
  OIDC_GENERIC
}

model SSOConfiguration {
  id             String        @id @default(uuid())
  workspaceId    String        @unique
  workspace      Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  provider       SSOProvider   @default(OIDC_AZURE_AD)
  domain         String        @unique // e.g., 'sonatrach.dz', 'mtn.com'
  clientId       String?
  clientSecret   String?
  discoveryUrl   String?
  entryPoint     String?       // SAML IdP URL
  cert           String?       @db.Text // SAML X.509 cert
  issuer         String?       // SAML Issuer / EntityID
  defaultRole    WorkspaceRole @default(MEMBER)
  enforceSSO     Boolean       @default(false)
  autoProvision  Boolean       @default(true) // JIT Provisioning
  enabled        Boolean       @default(true)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}

model SCIMApiKey {
  id          String    @id @default(uuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String
  tokenHash   String    @unique
  lastUsedAt  DateTime?
  expiresAt   DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  @@index([workspaceId])
}
